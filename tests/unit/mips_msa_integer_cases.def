/* Independent 64-bit lane results: instruction, A, B, A op B, B op A. */
MSA_CASE(0x78600011, 1, 2, 0xffffffffffffffff, 1)
MSA_CASE(0x78600011, 0x8000000000000000, 0x8000000000000000, 0, 0)
MSA_CASE(0x78600011, 0x8000000000000000, 1, 0x8000000000000000, 0x7fffffffffffffff)
MSA_CASE(0x78600011, 0x7fffffffffffffff, 0xffffffffffffffff, 0x7fffffffffffffff, 0x8000000000000000)
MSA_CASE(0x79600010, 0x7fffffffffffffff, 1, 0x7fffffffffffffff, 0x7fffffffffffffff)
MSA_CASE(0x79600010, 0x8000000000000000, 0xffffffffffffffff, 0x8000000000000000, 0x8000000000000000)
MSA_CASE(0x79600010, 0x8000000000000000, 0x7fffffffffffffff, 0xffffffffffffffff, 0xffffffffffffffff)
MSA_CASE(0x78600010, 0x8000000000000000, 0x8000000000000000, 0, 0)
MSA_CASE(0x78e00010, 0x8000000000000000, 0x8000000000000000, 0x7fffffffffffffff, 0x7fffffffffffffff)
MSA_CASE(0x78e00010, 0x8000000000000000, 0, 0x7fffffffffffffff, 0x7fffffffffffffff)
MSA_CASE(0x7b60000e, 0x8000000000000000, 0x7fffffffffffffff, 0x8000000000000000, 0x8000000000000000)
MSA_CASE(0x7be0000e, 0x8000000000000000, 0x7fffffffffffffff, 0x7fffffffffffffff, 0x7fffffffffffffff)
MSA_CASE(0x7b60000e, 1, 0xffffffffffffffff, 0xffffffffffffffff, 1)
MSA_CASE(0x7be0000e, 1, 0xffffffffffffffff, 0xffffffffffffffff, 1)
MSA_CASE(0x79e00010, 0xffffffffffffffff, 1, 0xffffffffffffffff, 0xffffffffffffffff)
MSA_CASE(0x78e00011, 1, 2, 0, 1)
MSA_CASE(0x7a600010, 0x8000000000000000, 0x7fffffffffffffff, 0xffffffffffffffff, 0xffffffffffffffff)
MSA_CASE(0x7b600010, 0x8000000000000000, 0x7fffffffffffffff, 0, 0)
MSA_CASE(0x7ae00010, 0xffffffffffffffff, 0xffffffffffffffff, 0xffffffffffffffff, 0xffffffffffffffff)
MSA_CASE(0x7be00010, 0xffffffffffffffff, 0, 0x8000000000000000, 0x8000000000000000)
/* Existing wrapping helpers require the QEMU -fwrapv compile contract. */
MSA_CASE(0x7860000e, 0x7fffffffffffffff, 1, 0x8000000000000000, 0x8000000000000000)
