#ifdef UC_STATUS_EXPLICIT
UC_STATUS_EXPLICIT(UC_X86_REG_RSP, 0x40, 0xb4, 0xa5)
UC_STATUS_EXPLICIT(UC_X86_REG_R12, 0x41, 0xb4, 0xa5)
