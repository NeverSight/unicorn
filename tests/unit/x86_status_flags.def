UC_STATUS_REX(1, 0x49, 0, 0)
UC_STATUS_REX(1, 0x4a, 0, 0)
UC_STATUS_REX(1, 0x4b, 0, 0)
UC_STATUS_REX(1, 0x4c, 0, 0)
UC_STATUS_REX(1, 0x4d, 0, 0)
UC_STATUS_REX(1, 0x4e, 0, 0)
