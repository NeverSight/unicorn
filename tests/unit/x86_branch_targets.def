/* Original relative-branch regression data; Unicorn unit-test license. */
#ifdef UC_BRANCH_VALUE
UC_BRANCH_VALUE(Page, 4096)
UC_BRANCH_VALUE(Code16, 0x2000)
UC_BRANCH_VALUE(Code32, 0x10000)
UC_BRANCH_VALUE(EntryOffset, 1024)
UC_BRANCH_VALUE(Nop, 0x90)
UC_BRANCH_VALUE(MaxPrefixBytes, 3)
UC_BRANCH_VALUE(MaxInstructionBytes, 15)
UC_BRANCH_VALUE(OpcodeEscape, 0x0f)
UC_BRANCH_VALUE(ShortBytes, 1)
UC_BRANCH_VALUE(HalfBytes, 2)
UC_BRANCH_VALUE(WordBytes, 4)
UC_BRANCH_VALUE(ByteBits, 8)
UC_BRANCH_VALUE(OneInstruction, 1)
UC_BRANCH_VALUE(IntelModel, UC_CPU_X86_HASWELL)
UC_BRANCH_VALUE(AMDModel, UC_CPU_X86_PHENOM)
UC_BRANCH_VALUE(ReservedFlag, 2)
UC_BRANCH_VALUE(CarryFlag, 1)
UC_BRANCH_VALUE(ParityFlag, 4)
UC_BRANCH_VALUE(ZeroFlag, 0x40)
UC_BRANCH_VALUE(SignFlag, 0x80)
UC_BRANCH_VALUE(OverflowFlag, 0x800)
UC_BRANCH_VALUE(FlagCombinations, 32)
#endif
#ifdef UC_BRANCH_WIDE_VALUE
UC_BRANCH_WIDE_VALUE(Code64, 0x100010000ULL)
UC_BRANCH_WIDE_VALUE(SeedAX, 0x1234567887654321ULL)
UC_BRANCH_WIDE_VALUE(SeedCX, 0x1234000000000000ULL)
UC_BRANCH_WIDE_VALUE(SeedSP, 0xfedcba9876543210ULL)
UC_BRANCH_WIDE_VALUE(SeedR9, 0x9988776655443322ULL)
#endif
#ifdef UC_BRANCH_TEXT
UC_BRANCH_TEXT(CaseContext,
               "mode=%u prefix=%zu operation=%zu near=%u flags=%x offset=%d "
               "pc=%llx/%llx length=%u/%zu")
#endif
#ifdef UC_BRANCH_OPERATION
UC_BRANCH_OPERATION(JO, 0x70, 0x80, O)
UC_BRANCH_OPERATION(JNO, 0x71, 0x81, !O)
UC_BRANCH_OPERATION(JB, 0x72, 0x82, C)
UC_BRANCH_OPERATION(JAE, 0x73, 0x83, !C)
UC_BRANCH_OPERATION(JE, 0x74, 0x84, Z)
UC_BRANCH_OPERATION(JNE, 0x75, 0x85, !Z)
UC_BRANCH_OPERATION(JBE, 0x76, 0x86, C || Z)
UC_BRANCH_OPERATION(JA, 0x77, 0x87, !C && !Z)
UC_BRANCH_OPERATION(JS, 0x78, 0x88, S)
UC_BRANCH_OPERATION(JNS, 0x79, 0x89, !S)
UC_BRANCH_OPERATION(JP, 0x7a, 0x8a, P)
UC_BRANCH_OPERATION(JNP, 0x7b, 0x8b, !P)
UC_BRANCH_OPERATION(JL, 0x7c, 0x8c, S != O)
UC_BRANCH_OPERATION(JGE, 0x7d, 0x8d, S == O)
UC_BRANCH_OPERATION(JLE, 0x7e, 0x8e, Z || S != O)
UC_BRANCH_OPERATION(JG, 0x7f, 0x8f, !Z && S == O)
UC_BRANCH_OPERATION(JMP, 0xeb, 0xe9, true)
#endif
#ifdef UC_BRANCH_PREFIX
UC_BRANCH_PREFIX(0, false, false, 0, 0)
UC_BRANCH_PREFIX(1, true, false, 0x66, 0)
UC_BRANCH_PREFIX(1, false, false, 0x67, 0)
UC_BRANCH_PREFIX(2, true, false, 0x66, 0x67)
UC_BRANCH_PREFIX(1, false, true, 0x48, 0)
UC_BRANCH_PREFIX(1, false, true, 0x41, 0)
UC_BRANCH_PREFIX(2, false, true, 0x67, 0x48)
UC_BRANCH_PREFIX(2, false, true, 0x66, 0x48)
UC_BRANCH_PREFIX(3, false, true, 0x66, 0x67, 0x48)
#endif
#ifdef UC_BRANCH_DISPLACEMENT
UC_BRANCH_DISPLACEMENT(-128)
UC_BRANCH_DISPLACEMENT(-16)
UC_BRANCH_DISPLACEMENT(0)
UC_BRANCH_DISPLACEMENT(16)
UC_BRANCH_DISPLACEMENT(127)
#endif
#ifdef UC_BRANCH_TEST
UC_BRANCH_TEST(IntelLongModeTargets, intelLongModeTargets)
UC_BRANCH_TEST(AMDLongModeTargets, amdLongModeTargets)
UC_BRANCH_TEST(Legacy32Targets, legacy32Targets)
UC_BRANCH_TEST(Legacy16Targets, legacy16Targets)
#endif
